# Copy this file to local_settings.py and fill in your database credentials.
#
#   cp webapp/local_settings.py.example webapp/local_settings.py
#
# local_settings.py is gitignored (pattern: local_settings*.py) — keep real
# credentials out of git. manage.py loads this module by default
# (DJANGO_SETTINGS_MODULE=webapp.local_settings).
from .settings import *  # noqa: F401,F403
import os

DEBUG = True

# Generate your own, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
SECRET_KEY = 'change-me-to-a-random-string'

BASE_DIR = os.path.dirname(os.path.dirname(__file__))

USE_X_FORWARDED_HOST = True
FORCE_SCRIPT_NAME = ''
URL_ROOT = FORCE_SCRIPT_NAME

STATIC_URL = URL_ROOT + '/static/'
STATIC_ROOT = os.path.join(BASE_DIR, "static/")

MEDIA_URL = URL_ROOT + '/media/'
MEDIA_ROOT = os.path.join(BASE_DIR, "media/")

# Remote SQL Server connection. The host typically lives on the UTAS network,
# so you must be on the VPN for the backend to reach it.
# Ask a team member for the host / database / credentials.
DATABASES = {
    'default': {
        'ENGINE': 'mssql',
        'NAME': 'YOUR_DB_NAME',
        'USER': 'YOUR_DB_USER',
        'PASSWORD': 'YOUR_DB_PASSWORD',
        'HOST': 'your-db-host.its.utas.edu.au',
        'OPTIONS': {
            'driver': 'ODBC Driver 18 for SQL Server',
            'extra_params': 'TrustServerCertificate=yes;',
        },
    }
}

# The app expects a 'transects' connection too; same DB is fine for dev.
DATABASES['transects'] = DATABASES['default']

ALLOWED_HOSTS = ['*']

CORS_ORIGIN_WHITELIST = [
    'http://localhost:3451',
    'http://localhost:3000',
]

# Path to ogr2ogr (provided by gdal-bin in the Docker image).
OGR2OGR_PATH = 'ogr2ogr'

EMAIL_BACKEND = 'django.core.mail.backends.console.EmailBackend'

WORDPRESS_URL = ''

# Ask a team member if you need a working key; leave blank otherwise.
SQUIDLE_API_KEY = ''

IS_PRODUCTION = False

# Human-readable app name for emails.
SITE_NAME = "Seamap Australia"
