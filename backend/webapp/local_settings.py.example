# Django local settings — values are read from the environment.
#
# Under Docker this file is copied to local_settings.py automatically the first
# time the backend container starts (see backend/docker/entrypoint.sh), and the
# values below are populated from the variables in the repo-root .env file (see
# .env.example). manage.py loads this module by default
# (DJANGO_SETTINGS_MODULE=webapp.local_settings).
#
# local_settings.py is gitignored (pattern: local_settings*.py) so any local
# overrides you make to the copy stay out of git.
from .settings import *  # noqa: F401,F403
import os


def env_bool(name, default=False):
    return os.environ.get(name, str(default)).strip().lower() in ('1', 'true', 'yes', 'on')


DEBUG = env_bool('DEBUG', True)

# Generate your own, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
SECRET_KEY = os.environ.get('SECRET_KEY', 'change-me-to-a-random-string')

BASE_DIR = os.path.dirname(os.path.dirname(__file__))

USE_X_FORWARDED_HOST = True
FORCE_SCRIPT_NAME = ''
URL_ROOT = FORCE_SCRIPT_NAME

STATIC_URL = URL_ROOT + '/static/'
STATIC_ROOT = os.path.join(BASE_DIR, "static/")

MEDIA_URL = URL_ROOT + '/media/'
MEDIA_ROOT = os.path.join(BASE_DIR, "media/")

# Remote SQL Server connection. The host typically lives on the UTAS network,
# so you must be on the VPN for the backend to reach it. Ask a team member for
# the host / database / credentials and set them in .env.
DATABASES = {
    'default': {
        'ENGINE': os.environ.get('DB_ENGINE', 'mssql'),
        'NAME': os.environ.get('DB_NAME', 'YOUR_DB_NAME'),
        'USER': os.environ.get('DB_USER', 'YOUR_DB_USER'),
        'PASSWORD': os.environ.get('DB_PASSWORD', 'YOUR_DB_PASSWORD'),
        'HOST': os.environ.get('DB_HOST', 'your-db-host.its.utas.edu.au'),
        'PORT': os.environ.get('DB_PORT', '1433'),
        'OPTIONS': {
            'driver': os.environ.get('DB_DRIVER', 'ODBC Driver 18 for SQL Server'),
            'extra_params': os.environ.get('DB_EXTRA_PARAMS', 'TrustServerCertificate=yes;'),
        },
    }
}

# The app expects a 'transects' connection too; same DB is fine for dev.
DATABASES['transects'] = DATABASES['default']

ALLOWED_HOSTS = ['*']

CORS_ORIGIN_WHITELIST = [
    'http://localhost:3451',
    'http://localhost:3000',
]

# Path to ogr2ogr (provided by gdal-bin in the Docker image).
OGR2OGR_PATH = os.environ.get('OGR2OGR_PATH', 'ogr2ogr')

EMAIL_BACKEND = 'django.core.mail.backends.console.EmailBackend'

WORDPRESS_URL = os.environ.get('WORDPRESS_URL', '')

# Ask a team member if you need a working key; leave blank otherwise.
SQUIDLE_API_KEY = os.environ.get('SQUIDLE_API_KEY', '')

IS_PRODUCTION = env_bool('IS_PRODUCTION', False)

# Human-readable app name for emails.
SITE_NAME = os.environ.get('SITE_NAME', 'Seamap Australia')
