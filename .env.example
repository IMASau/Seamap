# Copy to .env and adjust as needed. docker compose picks up .env automatically.
#
# Compose project name. Defaults to the basename of the checkout directory, so
# the main repo is "seamap" but a worktree at e.g. ../Seamap-local-dev-docker
# becomes "seamap-local-dev-docker" — a different project, with empty named
# volumes. Pin this if you're running from a worktree and want to keep the
# main checkout's wp-data / mssql-data / etc. (Safe to leave unset in a
# single-checkout setup.)
# COMPOSE_PROJECT_NAME=seamap

# SQL Server SA password (must satisfy SQL Server's complexity rules: 8+ chars
# with three of: uppercase, lowercase, digit, symbol).
MSSQL_SA_PASSWORD=SeamapDev123!

# Database name used by Django (created on first migrate).
DB_NAME=seamap
DB_USER=sa

# Set to 1 to use SQLite instead of SQL Server (faster, but Sentry-flagged
# SQL Server issues won't reproduce).
USE_SQLITE=0

# Host-side port mappings. Other sibling IMAS dev stacks use 1433/1434/etc., so
# Seamap defaults to 1435 to avoid clashes. Adjust to taste.
MSSQL_HOST_PORT=1435
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3451
FRONTEND_NREPL_PORT=8777
# shadow-cljs dev/devtools server (also hosts the hot-reload websocket).
FRONTEND_SHADOW_PORT=9630
GEOSERVER_HOST_PORT=8080
WP_HOST_PORT=8888

# GeoServer: bind-mounted clone of IMASau/geoserver-config-imas as
# GEOSERVER_DATA_DIR. Default is ../geoserver-config-imas (sibling of this
# repo); override if you keep it elsewhere. Login: admin / geoserver.
# Run scripts/geoserver-config-clone.sh to populate.
GEOSERVER_CONFIG_PATH=../geoserver-config-imas

# Optional: pin a specific GeoServer WAR build. The fetch service takes the
# newest release of IMASau/geoserver-build whose name contains this filter,
# then the first asset starting with "geoserver". Defaults track "master".
# Use e.g. `versionbump-2.28.0` to lock to a specific version bump release.
# GEOSERVER_WAR_TAG_FILTER=master
# GEOSERVER_WAR_FORCE_REFRESH=0
# GEOSERVER_HEAP=-Xms512m -Xmx2g

# Trigger best-effort load of database/{Types,Tables,Functions,Views,Procedures}
# during dbinit. Off by default — most files have FK/drift issues, so load
# targeted files manually when reproducing a specific issue.
LOAD_SCHEMA=0

# WordPress (story-maps + region-reports authoring). Default admin credentials
# are intentionally weak — change them in .env if your local environment is
# reachable beyond loopback.
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress
WP_URL=http://localhost:8888
WP_TITLE=Seamap Local
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# ACF Pro auto-fetch. ACF Pro is paid plugin source — kept out of this public
# repo (wordpress/.gitignore) and mirrored as a zip on a private IMAS-org
# release. The acf-fetch compose service pulls it on `docker compose up`.
#
# One-time vendor setup (per IMAS team — not per developer):
#   1. Create the private repo: `gh repo create IMASau/seamap-vendor --private`
#   2. Zip the current ACF Pro source and upload as a release asset:
#        cd wordpress/plugins
#        zip -qr /tmp/advanced-custom-fields-pro.zip advanced-custom-fields-pro
#        gh release create acf-pro-6.8.0.1 \
#          --repo IMASau/seamap-vendor \
#          --title "ACF Pro 6.8.0.1" \
#          --notes "Mirror for Seamap local dev" \
#          /tmp/advanced-custom-fields-pro.zip
#
# Per-developer setup: paste a GitHub PAT below with read access to the vendor
# repo. A fine-grained PAT scoped only to IMASau/seamap-vendor (Contents:read)
# is the lowest-blast-radius option. `gh auth token` works for quick local use
# but expires when you rotate credentials.
#
# Leave blank to skip the fetch — the stack still boots; story-map /
# region-report activation will be skipped by wp-init.
GITHUB_TOKEN=
ACF_PRO_REPO=IMASau/seamap-vendor
ACF_PRO_RELEASE_TAG=acf-pro-6.8.0.1
ACF_PRO_ASSET=advanced-custom-fields-pro.zip
