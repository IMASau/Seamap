# Copy to .env and fill in. Read by docker compose (see DOCKER.md).

# ── Backend: remote SQL Server (UTAS network — VPN required) ────────────────
# Ask a team member for these.
DB_HOST=your-db-host.its.utas.edu.au
DB_PORT=1433
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes;

# ── Backend: misc ───────────────────────────────────────────────────────────
# SECRET_KEY=
# SQUIDLE_API_KEY=
# WordPress as seen from inside the backend container (default shown).
# WORDPRESS_URL=http://wordpress/

# ── WordPress ───────────────────────────────────────────────────────────────
# wp-admin login created on first `docker compose up`.
# WP_ADMIN_USER=admin
# WP_ADMIN_PASSWORD=admin

# Fine-grained GitHub PAT with Contents:read on IMASau/seamap-vendor, used to
# fetch ACF Pro. Leave empty to use the free Secure Custom Fields plugin instead.
ACF_GITHUB_TOKEN=
