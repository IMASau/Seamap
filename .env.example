# Copy to .env and adjust as needed. docker compose picks up .env automatically.

# SQL Server SA password (must satisfy SQL Server's complexity rules: 8+ chars
# with three of: uppercase, lowercase, digit, symbol).
MSSQL_SA_PASSWORD=SeamapDev123!

# Database name used by Django (created on first migrate).
DB_NAME=seamap
DB_USER=sa

# Set to 1 to use SQLite instead of SQL Server (faster, but Sentry-flagged
# SQL Server issues won't reproduce).
USE_SQLITE=0

# Host-side port mappings. Other sibling IMAS dev stacks use 1433/1434/etc., so
# Seamap defaults to 1435 to avoid clashes. Adjust to taste.
MSSQL_HOST_PORT=1435
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3451
FRONTEND_NREPL_PORT=8777
# shadow-cljs dev/devtools server (also hosts the hot-reload websocket).
FRONTEND_SHADOW_PORT=9630
GEOSERVER_HOST_PORT=8080
WP_HOST_PORT=8888

# GeoServer admin credentials (default OSGeo values; change for anything but local dev).
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# Trigger best-effort load of database/{Types,Tables,Functions,Views,Procedures}
# during dbinit. Off by default — most files have FK/drift issues, so load
# targeted files manually when reproducing a specific issue.
LOAD_SCHEMA=0

# WordPress (story-maps + region-reports authoring). Default admin credentials
# are intentionally weak — change them in .env if your local environment is
# reachable beyond loopback.
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress
WP_URL=http://localhost:8888
WP_TITLE=Seamap Local
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
